# Copy to .env and edit. Real environment variables override this file.
# Keep real keys only in .env or your user environment; .env is git-ignored.

# --- Speech to text (faster-whisper) ---
WHISPER_MODEL=large-v3          # ~3.5 GB VRAM in float16; use medium or small if VRAM is tight
WHISPER_DEVICE=cuda             # cuda | cpu  (falls back to cpu automatically if CUDA fails)
WHISPER_COMPUTE_TYPE=float16    # float16 | int8_float16 | int8

# --- Rendering ---
VIDEO_ENCODER=h264_nvenc        # h264_nvenc | libx264  (falls back to libx264 if NVENC fails)
CLIP_LEN=30                     # seconds per clip; keep under SHORTS_MAX_SECONDS
OUTPUT_DIR=output

# --- Local LLM for titles/descriptions (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b          # ~9.3 GB at Q4; smaller option: qwen3:8b

# --- YouTube Shorts upload (YouTube Data API v3, OAuth) ---
YOUTUBE_PRIVACY=private         # private | unlisted | public
YOUTUBE_CATEGORY_ID=20          # 20 = Gaming
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=token.json
SHORTS_MAX_SECONDS=59

# --- Optional: live stream search + chat scoring ---
# YOUTUBE_API_KEY=
